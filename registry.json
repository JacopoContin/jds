{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "jds",
  "homepage": "https://jds-ruddy.vercel.app",
  "items": [
    {
      "name": "style",
      "type": "registry:style",
      "title": "JDS style",
      "description": "Neutral light and dark themes, status colors, motion keyframes, and shared utilities.",
      "dependencies": [
        "motion",
        "lucide-react",
        "tw-animate-css"
      ],
      "registryDependencies": [
        "@jds/utils"
      ],
      "cssVars": {
        "theme": {
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "ease-out-quint": "cubic-bezier(0.22, 1, 0.36, 1)",
          "ease-in-out-quart": "cubic-bezier(0.76, 0, 0.24, 1)",
          "animate-shimmer": "shimmer 2s linear infinite",
          "animate-pulse-soft": "pulse-soft 1.6s var(--ease-in-out-quart) infinite"
        },
        "light": {
          "radius": "0.625rem",
          "background": "oklch(0.985 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.205 0 0)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.955 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.96 0 0)",
          "muted-foreground": "oklch(0.52 0 0)",
          "accent": "oklch(0.95 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "destructive-foreground": "oklch(0.5 0.2 27)",
          "border": "oklch(0.91 0 0)",
          "input": "oklch(0.89 0 0)",
          "ring": "oklch(0.6 0 0)",
          "success": "oklch(0.6 0.13 150)",
          "success-foreground": "oklch(0.45 0.1 150)",
          "warning": "oklch(0.75 0.15 80)",
          "warning-foreground": "oklch(0.5 0.11 70)",
          "info": "oklch(0.6 0.12 240)",
          "info-foreground": "oklch(0.48 0.1 240)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.975 0 0)",
          "sidebar-foreground": "oklch(0.145 0 0)",
          "sidebar-primary": "oklch(0.205 0 0)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.95 0 0)",
          "sidebar-accent-foreground": "oklch(0.205 0 0)",
          "sidebar-border": "oklch(0.91 0 0)",
          "sidebar-ring": "oklch(0.6 0 0)"
        },
        "dark": {
          "background": "oklch(0.185 0 0)",
          "foreground": "oklch(0.94 0 0)",
          "card": "oklch(0.21 0 0)",
          "card-foreground": "oklch(0.94 0 0)",
          "popover": "oklch(0.225 0 0)",
          "popover-foreground": "oklch(0.94 0 0)",
          "primary": "oklch(0.94 0 0)",
          "primary-foreground": "oklch(0.2 0 0)",
          "secondary": "oklch(0.26 0 0)",
          "secondary-foreground": "oklch(0.94 0 0)",
          "muted": "oklch(0.245 0 0)",
          "muted-foreground": "oklch(0.68 0 0)",
          "accent": "oklch(0.27 0 0)",
          "accent-foreground": "oklch(0.94 0 0)",
          "destructive": "oklch(0.68 0.17 25)",
          "destructive-foreground": "oklch(0.75 0.14 25)",
          "border": "oklch(1 0 0 / 9%)",
          "input": "oklch(1 0 0 / 13%)",
          "ring": "oklch(0.55 0 0)",
          "success": "oklch(0.72 0.13 150)",
          "success-foreground": "oklch(0.8 0.11 150)",
          "warning": "oklch(0.8 0.13 85)",
          "warning-foreground": "oklch(0.85 0.11 85)",
          "info": "oklch(0.7 0.1 240)",
          "info-foreground": "oklch(0.8 0.08 240)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.2 0 0)",
          "sidebar-foreground": "oklch(0.94 0 0)",
          "sidebar-primary": "oklch(0.94 0 0)",
          "sidebar-primary-foreground": "oklch(0.2 0 0)",
          "sidebar-accent": "oklch(0.26 0 0)",
          "sidebar-accent-foreground": "oklch(0.94 0 0)",
          "sidebar-border": "oklch(1 0 0 / 9%)",
          "sidebar-ring": "oklch(0.55 0 0)"
        }
      },
      "css": {
        "@keyframes shimmer": {
          "from": {
            "background-position": "100% 0"
          },
          "to": {
            "background-position": "-100% 0"
          }
        },
        "@keyframes pulse-soft": {
          "0%, 100%": {
            "opacity": "0.4"
          },
          "50%": {
            "opacity": "1"
          }
        }
      }
    },
