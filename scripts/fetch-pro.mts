/**
 * Pulls JDS Pro components and their demos from the private jds-pro repo so the docs can render
 * live previews. Runs before `dev` and `build`. Everything it writes is gitignored: pro source
 * must never be committed to this public repo. The site only ships it compiled and minified,
 * and the docs never show it.
 *
 * Reads JDS_PRO_REGISTRY_URL and JDS_PRO_REGISTRY_TOKEN, the same variables the gated
 * /r/pro route uses. Without them, or if the fetch fails, it writes an empty preview map and
 * pro pages show a placeholder instead of breaking the build.
 */
import { existsSync, mkdirSync, rmSync, writeFileSync } from "node:fs"
import { dirname } from "node:path"

if (existsSync(".env.local")) process.loadEnvFile(".env.local")

const COMPONENTS = "components/pro"
const EXAMPLES = "examples/pro"

type Item = { name: string; files?: { path: string; content?: string }[] }

const base = process.env.JDS_PRO_REGISTRY_URL
const token = process.env.JDS_PRO_REGISTRY_TOKEN

async function get(path: string) {
  const res = await fetch(`${base}/${path}`, {
    headers: {
      Accept: "application/vnd.github.raw+json",
      ...(token && { Authorization: `Bearer ${token}` }),
    },
  })
  if (res.status === 404) return null
  if (!res.ok) throw new Error(`${res.status} fetching ${path}`)
  return res.text()
}

function write(path: string, content: string) {
  mkdirSync(dirname(path), { recursive: true })
  writeFileSync(path, content)
}

async function pull() {
  const index = await get("registry.json")
  if (!index) throw new Error("registry.json not found")
  const names = (JSON.parse(index) as { items: { name: string }[] }).items.map((i) => i.name)
  const demos: string[] = []

  for (const name of names) {
    const raw = await get(`${name}.json`)
    if (!raw) continue
    for (const file of (JSON.parse(raw) as Item).files ?? []) {
      // Only ever write inside components/pro, whatever the item says.
      if (!file.content || !file.path.startsWith(`${COMPONENTS}/`) || file.path.includes("..")) {
        throw new Error(`${name}: refusing to write ${file.path}`)
      }
      write(file.path, file.content)
    }
    const demo = await get(`examples/${name}-demo.tsx`)
    if (demo) {
      write(`${EXAMPLES}/${name}-demo.tsx`, demo)
      demos.push(`${name}-demo`)
    }
  }
  return { names, demos }
}

function writeIndex(demos: string[]) {
  const entries = demos.map((d) => `  "${d}": dynamic(() => import("./${d}")),`).join("\n")
  write(
    `${EXAMPLES}/index.tsx`,
    `"use client"

// Generated by scripts/fetch-pro.mts. Do not edit or commit.
import dynamic from "next/dynamic"
import type { ComponentType } from "react"

export const proExamples: Record<string, ComponentType> = {
${entries}
}
`
  )
}

rmSync(COMPONENTS, { recursive: true, force: true })
rmSync(EXAMPLES, { recursive: true, force: true })

if (!base) {
  console.log("JDS Pro: JDS_PRO_REGISTRY_URL not set, pro previews will show a placeholder.")
  writeIndex([])
} else {
  try {
    const { names, demos } = await pull()
    writeIndex(demos)
    console.log(`JDS Pro: ${names.length} components, ${demos.length} previews.`)
  } catch (error) {
    // A failed fetch shouldn't block a deploy; pro pages fall back to the placeholder.
    console.warn(`JDS Pro: could not fetch pro components (${(error as Error).message}). Previews disabled.`)
    rmSync(COMPONENTS, { recursive: true, force: true })
    rmSync(EXAMPLES, { recursive: true, force: true })
    writeIndex([])
  }
}
